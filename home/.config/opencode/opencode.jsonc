{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "filesystem-mcp": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/mcp-filesystem-server", "/home/jpfeiff", "/tmp", "/media/jpfeiff"],
      "enabled": true
    },
    "llmdoc": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/llmdoc"],
      "environment": {
        "LLMDOC_SOURCES": "fastapi:http://127.0.0.1:8099/fastapi.llms.txt,flask:http://127.0.0.1:8099/flask.llms.txt,bash:http://127.0.0.1:8099/bash.llms.txt,zig:https://ziglang.org/documentation/master/",
        "LLMDOC_DB_PATH": "/home/jpfeiff/.local/share/llmdoc/index.db",
        "LLMDOC_SKIP_STARTUP_REFRESH": "true"
      },
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/@colbymchenry/codegraph/npm-shim.js", "serve", "--mcp"],
      "enabled": true
    },
    "github-mcp": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/github-mcp-server", "stdio"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    }
  },
  "permission": {
    "filesystem-mcp_*": "deny",
    "llmdoc_*": "deny",
    "github-mcp_*": "deny",
    "codegraph_*": "deny"
  },
  "references": {
    "3270manuals": {
      "repository": "moshix/3270BBS",
      "description": "3270BBS documentation: basic_manual.md (TIMESHARING BASIC language + commands), assembler_manual.md (S/360 assembler), 3270UserGuide.pdf (menus, editors, notes, SDSF, held output, TSO), README.md, ConfigurationFile_HowTo.md (tsu.cnf keys)"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "llmdoc_*": "allow"
      }
    },
    "build": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "llmdoc_*": "allow"
      }
    }
  }
}
