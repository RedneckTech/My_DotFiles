{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "jcodemunch-mcp": {
      "type": "local",
      "command": ["<unknown>"],
      "enabled": false
    },
    "github-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false
    }
  },
  "permission": {
    "filesystem-mcp_*": "deny",
    "context7_*": "deny",
    "jcodemunch-mcp_*": "deny",
    "github-mcp_*": "deny"
  },
  "references": {
    "3270manuals": {
      "repository": "moshix/3270BBS",
      "description": "3270BBS documentation: basic_manual.md (TIMESHARING BASIC language + commands), assembler_manual.md (S/360 assembler), 3270UserGuide.pdf (menus, editors, notes, SDSF, held output, TSO), README.md, ConfigurationFile_HowTo.md (tsu.cnf keys)"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "context7_*": "allow"
      }
    },
    "build": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "context7_*": "allow"
      }
    }
  }
}
