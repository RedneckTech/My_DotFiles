{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "filesystem-mcp": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/mcp-filesystem-server", "/home/jpfeiff", "/tmp", "/media/jpfeiff"],
      "enabled": true
    },
    "llmdoc": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/llmdoc"],
      "environment": {
        "LLMDOC_SOURCES": "fastapi:http://127.0.0.1:8099/fastapi.llms.txt,flask:http://127.0.0.1:8099/flask.llms.txt,bash:http://127.0.0.1:8099/bash.llms.txt,zig:https://ziglang.org/documentation/master/",
        "LLMDOC_DB_PATH": "/home/jpfeiff/.local/share/llmdoc/index.db",
        "LLMDOC_SKIP_STARTUP_REFRESH": "true"
      },
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/@colbymchenry/codegraph/npm-shim.js", "serve", "--mcp"],
      "enabled": true
    },
    "github-mcp": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/github-mcp-server", "stdio"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/@playwright/mcp/cli.js", "--headless", "--isolated"],
      "enabled": true
    },
    "markitdown": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/markitdown-mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"],
      "enabled": true
    },
    "memory-docs": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/@modelcontextprotocol/server-memory/dist/index.js"],
      "environment": {
        "MEMORY_FILE_PATH": "/home/jpfeiff/.local/share/opencode-memory/docs.jsonl"
      },
      "enabled": true
    },
    "memory-3270dev": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/@modelcontextprotocol/server-memory/dist/index.js"],
      "environment": {
        "MEMORY_FILE_PATH": "/home/jpfeiff/.local/share/opencode-memory/3270dev.jsonl"
      },
      "enabled": true
    },
    "memory-gendev": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/@modelcontextprotocol/server-memory/dist/index.js"],
      "environment": {
        "MEMORY_FILE_PATH": "/home/jpfeiff/.local/share/opencode-memory/gendev.jsonl"
      },
      "enabled": true
    },
    "terminal-driver": {
      "type": "local",
      "command": ["/home/jpfeiff/.local/bin/node", "/home/jpfeiff/.local/lib/node_modules/terminal-driver-mcp/dist/index.js"],
      "enabled": true
    }
  },
  "permission": {
    "filesystem-mcp_*": "deny",
    "llmdoc_*": "deny",
    "github-mcp_*": "deny",
    "codegraph_*": "deny",
    "playwright_*": "deny",
    "markitdown_*": "deny",
    "sequential-thinking_*": "deny",
    "memory-docs_*": "deny",
    "memory-3270dev_*": "deny",
    "memory-gendev_*": "deny",
    "terminal-driver_*": "deny"
  },
  "references": {
    "3270manuals": {
      "repository": "moshix/3270BBS",
      "description": "3270BBS documentation: basic_manual.md (TIMESHARING BASIC language + commands), assembler_manual.md (S/360 assembler), 3270UserGuide.pdf (menus, editors, notes, SDSF, held output, TSO), README.md, ConfigurationFile_HowTo.md (tsu.cnf keys)"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "codegraph_*": "allow"
      }
    },
    "build": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "codegraph_*": "allow",
        "playwright_*": "allow",
        "terminal-driver_*": "allow"
      }
    }
  }
}
