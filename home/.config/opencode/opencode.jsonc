{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "jcodemunch-mcp": {
      "type": "local",
      "command": ["<unknown>"],
      "enabled": false
    },
    "github-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false
    }
  },
  "permission": {
    "filesystem-mcp_*": "deny",
    "context7_*": "deny",
    "jcodemunch-mcp_*": "deny",
    "github-mcp_*": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "context7_*": "allow"
      }
    },
    "build": {
      "permission": {
        "filesystem-mcp_*": "allow",
        "context7_*": "allow"
      }
    }
  }
}
